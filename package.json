{
    "name": "webapp-kitchen-sink",
    "version": "1.0.0",
    "private": true,
    "engines": {
        "node": ">=24.21.0",
        "pnpm": ">=12.4.2"
    },
    "scripts": {
        "preinstall": "npx only-allow pnpm",
        "dev": "turbo run dev",
        "start": "turbo run start",
        "build": "turbo run build",
        "typecheck": "turbo run typecheck",
        "lint": "turbo run lint",
        "lint:write": "turbo run lint:write",
        "format": "turbo run format",
        "clean:modules": "bash -lc 'find . -type d -name node_modules -prune -print -exec rm -rf {} \\; && rm -f pnpm-lock.yaml'"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.14",
        "turbo": "2.10.13",
        "typescript": "7.0.2"
    },
    "packageManager": "pnpm@12.4.2"
}
